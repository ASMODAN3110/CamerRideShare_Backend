# PostgreSQL (external — not containerized in this project)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=camerrideshare

# Local development (outside Docker)
DATABASE_URL="postgresql://postgres:password@localhost:5432/camerrideshare?schema=public"
# In Docker, compose overrides DATABASE_URL to use host.docker.internal

# JWT Authentication
JWT_SECRET="change-me-in-production"

# Server
PORT=3000
