generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  INVESTOR
  DRIVER
}

enum MotoStatus {
  ACTIVE
  STOLEN
  BROKEN
}

enum PaymentType {
  PAYMENT
  EXPENSE
}

enum PaymentStatus {
  VERIFIED
  PENDING
}

enum IncidentStatus {
  OPEN
  RESOLVED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
}

model User {
  id                 Int          @id @default(autoincrement())
  email              String?      @unique
  passwordHash       String
  fullName           String
  role               UserRole
  phoneNumber        String       @unique
  avatarUrl          String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  motosAsDriver      Moto[]       @relation("DriverMotos")
  motosAsInvestor    Moto[]       @relation("InvestorMotos")
  payments           Payment[]
  incidents          Incident[]
  investments        Investment[]
  invitationsCreated Invitation[] @relation("InvitationCreator")
}

model Moto {
  id              Int          @id @default(autoincrement())
  model           String
  city            String
  status          MotoStatus   @default(ACTIVE)
  financedAmount  Int          @default(0)
  targetAmount    Int          @default(0)
  driverId        Int?
  investorId      Int?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  driver          User?        @relation("DriverMotos", fields: [driverId], references: [id])
  investor        User?        @relation("InvestorMotos", fields: [investorId], references: [id])
  investments     Investment[]
  incidents       Incident[]
}

model Investment {
  id         Int       @id @default(autoincrement())
  investorId Int
  motoId     Int
  amount     Int
  closedAt   DateTime?
  createdAt  DateTime  @default(now())
  investor   User      @relation(fields: [investorId], references: [id])
  moto       Moto      @relation(fields: [motoId], references: [id])

  @@index([investorId])
  @@index([motoId])
}

model Payment {
  id        Int           @id @default(autoincrement())
  driverId  Int
  amount    Int
  type      PaymentType
  status    PaymentStatus @default(PENDING)
  createdAt DateTime      @default(now())
  driver    User          @relation(fields: [driverId], references: [id])

  @@index([driverId])
  @@index([createdAt])
}

model Incident {
  id          Int            @id @default(autoincrement())
  driverId    Int
  motoId      Int?
  type        String
  description String
  status      IncidentStatus @default(OPEN)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  driver      User           @relation(fields: [driverId], references: [id])
  moto        Moto?          @relation(fields: [motoId], references: [id])

  @@index([driverId])
  @@index([status])
}

model Invitation {
  id          Int              @id @default(autoincrement())
  email       String
  role        UserRole
  token       String           @unique
  status      InvitationStatus @default(PENDING)
  expiresAt   DateTime
  createdById Int
  createdAt   DateTime         @default(now())
  createdBy   User             @relation("InvitationCreator", fields: [createdById], references: [id])

  @@index([email])
  @@index([status])
}

model DashboardSnapshot {
  id              Int      @id @default(autoincrement())
  period          String   @unique
  fleetTotal      Int
  activeInvestors Int
  monthlyRevenue  Int
  createdAt       DateTime @default(now())
}
